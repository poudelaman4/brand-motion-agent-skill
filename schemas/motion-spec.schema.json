{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/animation-logo-skill/motion-spec.schema.json",
  "title": "Animation Logo Motion Manifest",
  "type": "object",
  "required": [
    "name",
    "fps",
    "duration_frames",
    "canvas",
    "source_reference",
    "primary_concept",
    "settle_frame",
    "hold_start_frame",
    "reduced_motion",
    "background_variants",
    "poster_frame",
    "layers"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "duration_frames": {
      "type": "integer",
      "minimum": 1
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "source_reference": {
      "type": "string",
      "minLength": 1
    },
    "source_checksum": {
      "type": "string"
    },
    "source_profile": {
      "type": "string"
    },
    "primary_concept": {
      "type": "string",
      "minLength": 1
    },
    "settle_frame": {
      "type": "integer",
      "minimum": 0
    },
    "hold_start_frame": {
      "type": "integer",
      "minimum": 0
    },
    "reduced_motion": {
      "type": "string",
      "minLength": 1
    },
    "background_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "poster_frame": {
      "type": "integer",
      "minimum": 0
    },
    "target_player": {
      "type": "string"
    },
    "renderer": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "canvas",
          "background",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "canvas": {
            "$ref": "#/$defs/canvas"
          },
          "background": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "codec": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "detection": {
      "$ref": "#/$defs/detection"
    }
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "description": "Structural profile and ranked recommendation from scripts/profile_logo.py. Confidence is inferred on a vector source and provisional on a flattened raster; it is never observed.",
      "required": [
        "confidence",
        "primary",
        "supporting"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "capability_rung": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "complexity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "complexity_band": {
          "enum": [
            "atomic",
            "geometric",
            "moderate",
            "detailed",
            "illustrative"
          ]
        },
        "confidence": {
          "enum": [
            "inferred",
            "provisional",
            "blocked"
          ]
        },
        "primary": {
          "$ref": "#/$defs/recommendation"
        },
        "supporting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "technique",
              "code",
              "detail"
            ],
            "properties": {
              "technique": {
                "type": "string",
                "minLength": 1
              },
              "scenario_id": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "remedy": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "register": {
          "enum": [
            "corporate",
            "editorial",
            "friendly",
            "heritage",
            "luxury",
            "playful",
            "precision",
            "premium",
            "sport",
            "technology",
            "wellness"
          ]
        },
        "frequency": {
          "enum": [
            "rare",
            "occasional",
            "daily",
            "frequent",
            "keyboard"
          ]
        },
        "taste": {
          "$ref": "#/$defs/taste"
        }
      },
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "required": [
        "technique",
        "scenario_id"
      ],
      "properties": {
        "technique": {
          "$ref": "#/$defs/technique"
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": [
        "x",
        "y",
        "scale",
        "rotation",
        "opacity"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "stroke": {
      "type": "object",
      "description": "Draw-on channel. A stroke layer keeps a canonical final transform; the reveal is carried by dasharray and dashoffset, never by the transform.",
      "required": [
        "path_length",
        "dasharray",
        "dashoffset_from",
        "dashoffset_to"
      ],
      "properties": {
        "path_length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dasharray": {
          "type": "number",
          "minimum": 0
        },
        "dashoffset_from": {
          "type": "number"
        },
        "dashoffset_to": {
          "type": "number"
        },
        "linecap": {
          "enum": [
            "butt",
            "round",
            "square"
          ]
        },
        "linejoin": {
          "enum": [
            "miter",
            "round",
            "bevel"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "closed": {
          "type": "boolean"
        },
        "pen_lift": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "separation": {
      "type": "object",
      "description": "Explode vector. Direction is normalized and distance is in canvas units.",
      "required": [
        "axis",
        "distance"
      ],
      "properties": {
        "axis": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "distance": {
          "type": "number"
        },
        "depth": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "order_source": {
          "enum": [
            "authored",
            "z_order",
            "explicit"
          ]
        }
      },
      "additionalProperties": false
    },
    "morph": {
      "type": "object",
      "description": "True path interpolation. Requires matched segment counts and index correspondence; a transform-only approximation does not belong here.",
      "required": [
        "path_from",
        "path_to",
        "correspondence"
      ],
      "properties": {
        "path_from": {
          "type": "string",
          "minLength": 1
        },
        "path_to": {
          "type": "string",
          "minLength": 1
        },
        "correspondence": {
          "enum": [
            "matched",
            "resampled"
          ]
        },
        "segment_count": {
          "type": "integer",
          "minimum": 3
        }
      },
      "additionalProperties": false
    },
    "mask": {
      "type": "object",
      "description": "Mask or wipe channel. Reveal direction and feather are part of the identity decision, not a rendering detail.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "alpha",
            "luma",
            "vector",
            "clip",
            "conic",
            "band",
            "wedge"
          ]
        },
        "angle": {
          "type": "number"
        },
        "feather": {
          "type": "number",
          "minimum": 0
        },
        "from_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "to_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "description": "Bounded, deterministic effect channels. Every stochastic value is derived from seed and frame, never from runtime randomness.",
      "properties": {
        "particle_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "lifetime_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "turbulence_base_frequency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "turbulence_octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "sweep_type": {
          "enum": [
            "linear",
            "radial",
            "conic",
            "foil"
          ]
        },
        "sweep_angle": {
          "type": "number"
        },
        "blend_mode": {
          "enum": [
            "normal",
            "screen",
            "overlay",
            "add",
            "multiply"
          ]
        }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "role",
        "source",
        "bounds",
        "pivot",
        "z_index",
        "start_frame",
        "duration_frames",
        "from",
        "to",
        "easing",
        "confidence",
        "locked",
        "final_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "pivot": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "z_index": {
          "type": "integer"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "$ref": "#/$defs/transform"
        },
        "to": {
          "$ref": "#/$defs/transform"
        },
        "easing": {
          "enum": [
            "settle",
            "enter",
            "draw",
            "organic",
            "snap",
            "play",
            "path-linear",
            "morph"
          ]
        },
        "confidence": {
          "enum": [
            "observed",
            "inferred",
            "provisional",
            "blocked"
          ]
        },
        "locked": {
          "type": "boolean"
        },
        "final_state": {
          "type": "boolean"
        },
        "technique": {
          "$ref": "#/$defs/technique"
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "stroke": {
          "$ref": "#/$defs/stroke"
        },
        "separation": {
          "$ref": "#/$defs/separation"
        },
        "morph": {
          "$ref": "#/$defs/morph"
        },
        "mask": {
          "$ref": "#/$defs/mask"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "lighting": {
          "$ref": "#/$defs/lighting"
        }
      },
      "additionalProperties": false
    },
    "technique": {
      "description": "Technique keys emitted by scripts/profile_logo.py, mapped to scenario ids in references/taxonomy.md.",
      "enum": [
        "line_draw_on",
        "multi_stroke_trace",
        "kinetic_typography",
        "mask_wipe",
        "mask_wipe_mark",
        "circular_sweep",
        "particle_dissolve",
        "morph_shape",
        "separation_explode",
        "separation_ordered",
        "geometric_construction",
        "extrusion_3d",
        "bounce_elastic",
        "orbit_rotate",
        "orbit_rotate_badge",
        "gradient_sweep",
        "idle_loop",
        "scroll_scrub",
        "reduced_motion"
      ]
    },
    "taste": {
      "type": "object",
      "description": "Register veto, frequency budget, and cliche check from scripts/profile_logo.py. A vetoed technique is removed from the ranking rather than demoted.",
      "required": [
        "register",
        "budget",
        "permitted",
        "vetoed"
      ],
      "properties": {
        "register": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "object",
          "required": [
            "duration_ceiling_s",
            "gesture_ceiling",
            "overshoot_ceiling"
          ],
          "properties": {
            "duration_ceiling_s": {
              "type": "number",
              "minimum": 0
            },
            "gesture_ceiling": {
              "type": "integer",
              "minimum": 0
            },
            "overshoot_ceiling": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "permitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vetoed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "technique",
              "reason"
            ],
            "properties": {
              "technique": {
                "type": "string",
                "minLength": 1
              },
              "scenario_id": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "register": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "cliches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "technique",
              "why"
            ],
            "properties": {
              "technique": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              },
              "dead_in": {
                "type": "string"
              },
              "replacement": {
                "type": "string"
              },
              "verdict": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lighting": {
      "type": "object",
      "description": "Shadow and light channels. A shadow is a relationship between two surfaces, so a lit layer needs a catcher; read references/craft/light-and-shadow.md before using one.",
      "properties": {
        "shadow_species": {
          "enum": [
            "none",
            "hard",
            "ambient",
            "contact",
            "cast",
            "directional"
          ]
        },
        "shadow_blur": {
          "type": "number",
          "minimum": 0
        },
        "shadow_offset": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "shadow_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shadow_color": {
          "type": "string"
        },
        "light_azimuth": {
          "type": "number"
        },
        "light_elevation": {
          "type": "number"
        },
        "specular_exponent": {
          "type": "number",
          "minimum": 0
        },
        "catcher": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
